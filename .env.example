# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git에 올라가지 않아요)

# Supabase > Project Settings > API (또는 상단 Connect 버튼)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon(public) 또는 publishable 키만 사용하세요. service_role 키는 절대 넣지 마세요!
VITE_SUPABASE_ANON_KEY=

# Pixabay > https://pixabay.com/api/docs/ (로그인하면 키가 보여요) - 서버 함수에서만 사용
PIXABAY_API_KEY=
